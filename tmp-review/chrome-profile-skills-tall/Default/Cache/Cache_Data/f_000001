  display:flex;
  flex-wrap:wrap;
  gap:8px;
}
.project-action-group--media{
  margin:8px 0 0;
  padding:8px 0 0;
  border:0;
  border-top:1px solid color-mix(in oklab, var(--read-border) 48%, transparent);
  background:transparent;
}
.project-action-group--media h4{
  margin-bottom:6px;
}
.project-action-group--game{
  border-color:color-mix(in oklab, var(--accent-500) 34%, var(--read-border));
  background:color-mix(in oklab, var(--panel) 92%, var(--accent-500) 8%);
}
.project-action-group--portfolio{
  background:transparent;
}
.project-action-group--reference{
  padding:10px 12px;
  background:color-mix(in oklab, var(--panel) 98%, var(--bg) 2%);
}
.action-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:36px;
  padding:8px 12px;
  border-radius:6px;
  border:1px solid color-mix(in oklab, var(--accent-500) 42%, var(--read-border));
  background:color-mix(in oklab, var(--panel) 86%, var(--accent-500) 14%);
  color:var(--read-text);
  font-weight:850;
  text-decoration:none;
}
.action-btn:hover{
  background:color-mix(in oklab, var(--panel) 74%, var(--accent-500) 26%);
}
.action-btn--secondary,
.action-btn--portfolio{
  border-color:color-mix(in oklab, var(--read-border) 82%, transparent);
  background:color-mix(in oklab, var(--panel) 94%, var(--bg) 6%);
}
.action-btn--reference{
  border-color:color-mix(in oklab, var(--read-border) 82%, transparent);
  background:transparent;
}
.action-btn--external{
  border-color:color-mix(in oklab, var(--accent-500) 58%, var(--read-border));
  background:color-mix(in oklab, var(--panel) 82%, var(--accent-500) 18%);
}
.action-btn--media{
  border-color:color-mix(in oklab, var(--read-border) 82%, transparent);
  background:transparent;
}
.project-info{
  display:grid;
  gap:14px;
  margin-top:12px;
}
.project-info h4{
  margin:0;
  font-size:18px;
}
.project-info-grid{
  display:grid;
  grid-template-columns:repeat(4, minmax(0, 1fr));
  gap:10px 14px;
  margin:0;
}
.project-info-row{
  min-width:0;
  padding:0 0 10px;
  border-bottom:1px solid color-mix(in oklab, var(--read-border) 58%, transparent);
}
.project-info-row--wide{
  grid-column:span 2;
}
.project-info-row--languages.project-info-row--wide{
  grid-column:1 / -1;
}
.project-info-row dt,
.project-info-description strong{
  display:block;
  margin:0 0 4px;
  color:var(--read-soft);
  font-size:11px;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.055em;
}
.project-info-row dd{
  margin:0;
  color:var(--read-text);
  font-size:14px;
  line-height:1.35;
  font-weight:720;
}
.project-info-description p{
  margin:0;
  color:var(--read-soft);
  line-height:1.6;
}
.project-modal-tags{
  margin:10px 0 0;
}
.project-tags{
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  gap:7px;
}
.project-tags strong{
  margin-right:2px;
  color:var(--read-soft);
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:.055em;
}
.project-tags span{
  display:inline-flex;
  align-items:center;
  min-height:24px;
  padding:3px 7px;
  border:0;
  border-radius:4px;
  background:color-mix(in oklab, var(--read-border) 24%, transparent);
  color:var(--read-muted);
  font-size:12px;
  font-weight:760;
}
.project-lead{
  margin-top:10px;
}
@media (max-width: 720px){
  .project-tile .thumb{ min-height:300px; aspect-ratio:4/5; }
  .project-tile .ovr{ padding:18px; }
  .project-tile .ovr-top{ flex-direction:column; align-items:flex-start; }
  .project-tile .ovr-bottom{ align-items:flex-start; flex-direction:column; }
  .project-tile .ovr-bottom .t{ font-size:clamp(30px, 11vw, 46px); }
  .project-cta{ margin-left:0; }
  .project-info-grid{ grid-template-columns:repeat(2, minmax(0, 1fr)); gap:9px 10px; }
  .project-info-row--wide{ grid-column:1 / -1; }
  .project-info-row dd{ font-size:13px; }
  .project-action-group{ padding:10px; }
  .modal--project .media-shell{ aspect-ratio:16/10; max-height:none; }
}
@media (max-width: 360px){
  .project-info-grid{ grid-template-columns:1fr; }
}

/* =======================
   CASES
======================= */
.cases-grid{
  display:grid;
  gap:22px;
  grid-template-columns: minmax(0, 1fr);
}
.case-tile{
  display:grid;
  grid-template-columns: var(--case-cols);
  gap:0;
  min-height: var(--case-min);
  width:100%;
  max-width:none;
  padding:0;
  overflow:hidden;
  justify-self:stretch;
}
.tile.case-tile{ min-height: var(--case-min) !important; }
.case-thumb{
  position:relative;
  min-height:320px;
  overflow:hidden;
  background:color-mix(in oklab, var(--panel) 88%, var(--bg));
}
.case-thumb .media{ position:absolute; inset:0; }
.case-thumb img,.case-thumb iframe{ width:100%; height:100%; object-fit:cover; display:block; }
.case-thumb::after{
  content:"";
  position:absolute; inset:0;
  background:linear-gradient(to top, rgba(0,0,0,.58), rgba(0,0,0,.08) 56%, transparent);
  pointer-events:none;
}
.case-thumb-meta{
  position:absolute; left:16px; right:16px; bottom:16px; z-index:1;
  display:flex; gap:8px; flex-wrap:wrap;
}
.case-thumb-meta span,
.case-tags span{
  display:inline-flex; align-items:center;
  border:1px solid color-mix(in oklab, var(--read-border) 72%, transparent);
  border-radius:6px;
  padding:6px 10px;
  font-size:12px;
  font-weight:800;
}
.case-thumb-meta span{
  color:#fff;
  border-color:rgba(255,255,255,.42);
  background:rgba(0,0,0,.34);
}
.case-tile .case-body{
  display:flex;
  flex-direction:column;
  gap:14px;
  padding:clamp(20px, 3vw, 34px);
}
.case-tags{ display:flex; gap:8px; flex-wrap:wrap; }
.case-tags span{ color:var(--read-chip); background:color-mix(in oklab, var(--panel) 90%, var(--bg) 10%); }
.case-title{ margin:0; font-size: clamp(28px, 3.4vw, 48px); line-height:1.02; font-weight:900; }
.case-lead{
  margin:0; opacity:1; line-height:1.55; font-size:clamp(15px, 1.2vw, 18px);
  display:-webkit-box; -webkit-line-clamp:4; -webkit-box-orient:vertical; overflow:hidden;
}
.case-metrics{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(150px, 1fr));
  gap:10px;
  margin:4px 0 0;
}
.case-metrics div{
  border:1px solid color-mix(in oklab, var(--read-border) 72%, transparent);
  border-radius:8px;
  padding:10px 12px;
  background:color-mix(in oklab, var(--panel) 92%, var(--bg) 8%);
}
.case-metrics dt{ font-size:clamp(20px, 2vw, 30px); font-weight:900; line-height:1; }
.case-metrics dd{ margin:5px 0 0; color:var(--read-soft); font-size:12px; line-height:1.3; }
.case-metrics--compact{ grid-template-columns:repeat(3, minmax(0, 1fr)); }
.case-metrics--compact dt{ font-size:22px; }
.case-link{
  margin-top:auto;
  display:inline-flex;
  align-self:flex-start;
  color:var(--read-text);
  font-weight:850;
  text-decoration:underline;
  text-underline-offset:4px;
}

@media (max-width: 920px){
  .case-tile{ grid-template-columns:1fr; }
  .case-thumb{ min-height:240px; aspect-ratio:var(--case-thumb-ar); }
  .case-metrics--compact{ grid-template-columns:repeat(auto-fit, minmax(120px, 1fr)); }
}

/* ===== Hard kill overflow on small viewports ===== */
@media (max-width: 900px){
  :where(body, .page-slab, .container, #hero-banner){ overflow-x: clip; }
}


/* Portfolio content refresh */
.project-placeholder{width:100%;height:100%;min-height:180px;display:grid;place-items:center;background:
  radial-gradient(240px 120px at 25% 20%, color-mix(in oklab,var(--accent-300) 30%,transparent), transparent 70%),
  linear-gradient(135deg,color-mix(in oklab,var(--panel) 92%,var(--bg) 8%),color-mix(in oklab,var(--panel) 82%,var(--accent-300) 8%));
}
.project-placeholder span{font-size:clamp(2rem,6vw,4rem);font-weight:900;letter-spacing:.08em;opacity:.42}
.project-lead p{margin:0;color:var(--ink-700);font-size:16px;line-height:1.55}
.project-section h4{margin:0 0 8px;font-size:16px}
.project-section p{margin:0 0 10px;color:var(--ink-700);line-height:1.6}
.clean-list{margin:0 0 0 18px;color:var(--ink-700);line-height:1.55}
.clean-list li{margin:6px 0}
.case-study{ display:grid; gap:16px; }
.case-overview{
  display:grid;
  grid-template-columns:minmax(0, 1.4fr) minmax(220px, .6fr);
  gap:16px;
  align-items:start;
  padding:18px 0 2px;
}
.case-overview p{
  margin:10px 0 0;
  font-size:clamp(16px, 1.35vw, 20px);
  line-height:1.55;
  color:var(--read-soft);
}
.case-facts{ display:grid; gap:10px; }
.case-facts span{
  display:grid;
  gap:4px;
  border-left:3px solid color-mix(in oklab, var(--accent-500) 65%, var(--read-border));
  padding:0 0 0 12px;
  color:var(--read-soft);
}
.case-facts strong{ color:var(--read-text); font-size:12px; text-transform:uppercase; letter-spacing:.04em; }
.case-article{max-width:none;margin:4px 0 0;padding:0}
.case-intro{
  max-width:88ch;
  font-size:clamp(17px, 1.35vw, 20px);
  line-height:1.72;
}
.case-article p{font-size:16px;line-height:1.72;color:var(--read-soft);margin:0 0 16px}
.case-section{
  display:grid;
  gap:18px;
  margin-top:26px;
  align-items:start;
}
.case-section--with-media{
  grid-template-columns:minmax(0, .98fr) minmax(280px, .72fr);
}
.case-section-copy h4,.case-article h4{
  font-size:clamp(22px,2.2vw,32px);
  line-height:1.12;
  margin:0 0 10px;
  color:var(--read-text);
}
.case-section-media{ min-width:0; }
.case-figure,.case-gallery-wrap{
  margin:0;
}
.case-figure img,.case-embed{
  width:100%;
  border-radius:8px;
  border:1px solid color-mix(in oklab, var(--read-border) 80%, transparent);
  overflow:hidden;
  background:color-mix(in oklab, var(--panel) 90%, var(--bg) 10%);
}
.case-figure img{ display:block; height:auto; object-fit:cover; }
.case-embed{ aspect-ratio:16/9; }
.case-figure figcaption,.case-gallery-wrap figcaption{
  margin-top:8px;
  color:var(--read-soft);
  font-size:13px;
  line-height:1.45;
}
.case-gallery{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));
  gap:10px;
}
.case-gallery-item{
  padding:0;
  border:0;
  border-radius:8px;
  overflow:hidden;
  background:transparent;
  cursor:pointer;
  text-align:left;
}
.case-gallery-item img{
  width:100%;
  aspect-ratio:16/10;
  object-fit:cover;
  display:block;
  transition:transform .2s var(--easing), filter .2s var(--easing);
}
.case-gallery-item:hover img{ transform:scale(1.025); filter:saturate(1.08); }
.case-gallery-item span{
  display:block;
  padding:8px 2px 0;
  color:var(--read-soft);
  font-size:13px;
}
.case-callout{
  border-left:4px solid color-mix(in oklab, var(--accent-500) 72%, var(--read-border));
  padding:12px 0 12px 16px;
  color:var(--read-soft);
}
.case-callout strong{
  display:block;
  color:var(--read-text);
  margin-bottom:6px;
}
.article-closing{font-weight:650;color:var(--read-text)!important;border-top:1px solid var(--ring);padding-top:18px;margin-top:26px!important}
.case-tile .case-lead{line-height:1.48}
.skill-card .skill-sum{line-height:1.45}
@media(max-width:860px){
  .case-overview,.case-section--with-media{ grid-template-columns:1fr; }
  .modal--case-study .media-shell{ aspect-ratio:16/10; }
}


/* =======================
   LISIBILITÉ
======================= */
[data-theme=light]{
  --read-text:#26221d;
  --read-muted:#494036;
  --read-soft:#5f5549;
  --read-chip:#3f382f;
  --read-border:#d7cbbb;
  --read-panel:color-mix(in oklab, var(--panel) 96%, #fff 4%);
  --logo-bg:#f4ead8;
  --logo-plate:#fffaf1;
  --logo-halo:rgba(255,255,255,.74);
  --logo-border:rgba(92,72,48,.24);
}
[data-theme=dark]{
  --read-text:#f0e9df;
  --read-muted:#d8cec1;
  --read-soft:#c8bcad;
  --read-chip:#e3d9cc;
  --read-border:#3a3129;
  --read-panel:color-mix(in oklab, var(--panel) 88%, #fff 5%);
  --logo-bg:#171310;
  --logo-plate:#e7ddce;
  --logo-halo:rgba(255,255,255,.08);
  --logo-border:rgba(255,255,255,.16);
}
body{ color:var(--read-text); }
.header,.card,.tile,.skill,.skill-cat,#contact .card,.modal{
  color:var(--read-text);
}
.card,.tile,.skill,.skill-cat,#contact .card{
  background:var(--read-panel);
  border-color:color-mix(in oklab, var(--read-border) 82%, transparent);
}
.summary,
.role-badge,
.skill-panel,
.skill-card .skill-sum,
.sm-sum,
.case-lead,
.project-lead p,
.project-section p,
.clean-list,
.case-article p,
#heroDesc,
#legalContent p,
.modal p{
  color:var(--read-soft) !important;
  opacity:1 !important;
}
.tile h3,
.case-title,
.skill-card h3,
.project-section h4,
.case-article h4,
.section h2,
.modal h2,
.modal h3{
  color:var(--read-text);
}
.badge,
.chip,
.chip-btn,
.pill,
.role-badge,
.btn{
  color:var(--read-chip);
  border-color:color-mix(in oklab, var(--read-border) 82%, transparent);
}
.badge,
.chip,
.chip-btn,
.pill{
  background:color-mix(in oklab, var(--panel) 88%, var(--bg) 12%);
}
[data-theme=dark] .badge,
[data-theme=dark] .chip,
[data-theme=dark] .chip-btn,
[data-theme=dark] .pill{
  background:color-mix(in oklab, var(--panel) 82%, #fff 7%);
}
.primary-nav a,
.brand-icon,
.footer,
.contact-row .pill{
  color:var(--read-muted);
}
.input,
.rte,
.rte-editor{
  color:var(--read-text);
  background:color-mix(in oklab, var(--panel) 94%, var(--bg) 6%);
  border-color:color-mix(in oklab, var(--read-border) 80%, transparent);
}
.input::placeholder,
.rte-editor:empty:before{
  color:var(--read-soft);
  opacity:.78;
}
.project-tile .ovr-bottom .t,
.project-tile .role-badge.o,
.project-cta{
  color:#fff !important;
}
