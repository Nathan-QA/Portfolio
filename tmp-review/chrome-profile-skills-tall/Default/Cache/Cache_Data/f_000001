/* =======================
   CURTAIN & PARTICLES
======================= */
.curtain{
  position:fixed; inset:0; z-index: 900; pointer-events:none;
  --slidePct: 0%;
  --treeX: 0px;
  --treeY: 0px;
  --treeOpacity: 1;
  overflow:hidden;                 /* sécurité anti-débordement */
}
.curtain .panel{
  position:absolute; top:0; bottom:0;
  border: none; background: transparent;
  will-change: transform, opacity, filter;
  transition: none;
  backface-visibility:hidden;
  transform-origin:center right;
}
.curtain .panel::after{
  content:""; position:absolute; inset:0; pointer-events:none;
  background-image: var(--leaf-img);
  background-repeat: no-repeat; background-size: var(--leaf-size, contain);
  background-position: var(--leaf-pos, center);
  transform: scale(var(--leafScale, 1));
  filter: brightness(var(--leafBright, 1)) drop-shadow(0 6px 18px rgba(0,0,0,.25));
}
.curtain .left::after { background-image: none !important; }
.curtain .right { right:0; width:50vw; transform: translate3d(var(--treeX), var(--treeY), 0); opacity:1; visibility:visible; }
.curtain .left::after  { --leaf-pos: left center; }
.curtain .right::after { --leaf-pos: right center; }

/* Thèmes */
:root { --leaf-img-day: url("assets/leaf_right.png"); --leaf-img-night: url("assets/leaf_rightN.png"); }
.curtain .right::after { background-image: var(--leaf-img-day); }
html[data-theme="dark"] .curtain .right::after { background-image: var(--leaf-img-night); }


/* >>> Désactive totalement le curtain en mobile/tablette <<< */
@media (max-width: 900px){
  #curtain, .curtain, .leaf-layer{ display:none !important; }
}

/* Couche globale de particules (au-dessus du header, sous les popups) */
.leaf-layer{
  position: fixed; inset:0;
  pointer-events: none; overflow: visible;
  z-index: 920; contain: paint;
}
.leaf{
  position:absolute; will-change: transform, opacity;
  width: var(--w,28px); height: var(--h,28px);
  background-image: url("assets/leaf_cliff_particles_grid_export.png");
  background-repeat: no-repeat;
  background-size: 300% 300%;
  background-position: var(--bx,0%) var(--by,0%);
  filter: drop-shadow(0 2px 2px rgba(0,0,0,.25));
  opacity: 0; transition: opacity .35s;
}

/* =======================
   HERO BANNER (fix)
======================= */
#hero-banner { background: none !important; aspect-ratio: auto !important; }
#hero-banner::before, #hero-banner::after { content: none !important; }

#hero-banner{
  --hero-h: 85vh;          /* hauteur visible desktop/tablette */
  --lift-fudge: 1px;       /* anti-liseré / arrondis */
  position: relative; width: 100%; height: var(--hero-h); overflow: hidden;
}

#hero-banner > .hero-img,
#hero-banner > .hero-lift{
  position: absolute; inset: 0; pointer-events: none;
  transition: opacity .35s ease;
  background-repeat: no-repeat;
  background-size: cover;                 /* << au lieu de 100% auto */
  background-position: center top;
  will-change: transform, opacity;
}

/* on coupe un peu plus bas/haut pour éviter le gap d’1 px */
#hero-banner > .hero-img{
  clip-path: inset(0 0 calc(var(--lift-h) + var(--lift-fudge)) 0);
}
#hero-banner > .hero-lift{
  z-index: 2;
  clip-path: inset(calc(100% - var(--lift-h) - var(--lift-fudge)) 0 0 0);
  transform: translateY(calc(-1 * var(--lift-h)));
  -webkit-mask-image: linear-gradient(to bottom, transparent 0, black 16px);
          mask-image: linear-gradient(to bottom, transparent 0, black 16px);
}

/* images jour/nuit */
#hero-banner > .hero-img.day,  #hero-banner > .hero-lift.day  { background-image: url("assets/bannerD.png"); opacity: 1; }
#hero-banner > .hero-img.night, #hero-banner > .hero-lift.night{ background-image: url("assets/bannerN.png"); opacity: 0; }
[data-theme="dark"] #hero-banner > .hero-img.day,
[data-theme="dark"] #hero-banner > .hero-lift.day   { opacity: 0; }
[data-theme="dark"] #hero-banner > .hero-img.night,
[data-theme="dark"] #hero-banner > .hero-lift.night { opacity: 1; }

@media (max-width: 700px){
  #hero-banner{ --hero-h: clamp(260px, 42vh, 380px);}
  #hero-banner > .hero-img,
  #hero-banner > .hero-lift{
    background-position: 30% center;
  }
}
@media (max-width: 560px){
  #hero-banner{ --hero-h: clamp(230px, 34vh, 320px);}
  #hero-banner > .hero-img,
  #hero-banner > .hero-lift{
    background-position: 28% center;
  }
}

