/* =======================
   TOKENS & THEME
======================= */
:root{
  --cream-0:#fffaf3;--cream-50:#fff4e5;--cream-100:#ffe9cc;
  --ink-900:#1c1b19;--ink-700:#3e3b36;--ink-600:#544f47;--ink-300:#b6b1a7;--ink-200:#d0cbc2;--ink-100:#eae7e2;
  --accent-300:#c7d2fe;--accent-500:#a5b4fc;
  --warm-900:#161311;--warm-800:#1e1a17;
  --radius:10px; --easing:cubic-bezier(.2,.8,.2,1);
  --container-max:1280px;

  /* Hauteur header (mise à jour en JS) + position collante pilotée */
  --headerH: 90px;
  --stickTop: calc(-1 * var(--headerH));

  /* === Études de cas : tailles constantes === */
  --case-w: 1120px;    /* largeur max d’une case study */
  --case-min: 360px;   /* hauteur mini */
  --case-thumb-ar: 16/9;
  --case-cols: minmax(320px, 1.05fr) minmax(320px, .95fr);
}

[data-theme=dark]{ --bg:var(--warm-900); --fg:var(--ink-100); --panel:var(--warm-800); --ring:#2a241f; --slab: color-mix(in oklab, var(--warm-800) 92%, #000 8%); color-scheme:dark; }
[data-theme=light]{ --bg:var(--cream-50); --fg:var(--ink-900); --panel:var(--cream-0); --ring:#e6dfd4; --slab: color-mix(in oklab, var(--cream-0) 88%, var(--cream-100) 12%); color-scheme:light; }

/* =======================
   BASE & UTILS
======================= */
*{ box-sizing:border-box }
html{min-height:100%; overflow-x:hidden;}  /* jamais de scroll horizontal */
body{min-height:100%; overflow-x:clip;}
html{ scroll-behavior:smooth; }
@media (prefers-reduced-motion: reduce){ html{ scroll-behavior:auto } }

body{
  margin:0;background:
    radial-gradient(80rem 60rem at -10% -15%,rgba(0,0,0,.04),transparent 60%),
    radial-gradient(60rem 50rem at 110% 5%,rgba(0,0,0,.05),transparent 55%),
    var(--bg);
  color:var(--fg);
  font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, "Helvetica Neue", Arial, "Noto Sans", "Apple Color Emoji", "Segoe UI Emoji";
}
body.theme-anim, body.theme-anim *{
  transition: background-color .35s var(--easing), color .35s var(--easing), border-color .35s var(--easing), box-shadow .35s var(--easing);
}
body.no-scroll{overflow:hidden}
a{color:inherit}
img{display:block;max-width:100%;height:auto}
iframe{border:0}
.container{max-width:var(--container-max);margin:0 auto;padding:0 20px}
.skip-link{
  position:fixed;
  left:16px;
  top:12px;
  z-index:3000;
  transform:translateY(-160%);
  border:1px solid var(--ring);
  border-radius:8px;
  padding:10px 12px;
  background:var(--panel);
  color:var(--fg);
  font-weight:800;
  text-decoration:none;
  box-shadow:0 10px 28px rgba(0,0,0,.18);
}
.skip-link:focus{ transform:translateY(0); }

/* Visually hidden but accessible */
.sr-only{
  position:absolute !important; width:1px; height:1px; padding:0; margin:-1px;
  overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0;
}

/* Focus rings */
:where(button, a, [role="button"], input, .chip-btn, .nav-toggle, .x, .back, .lb-prev, .lb-next):focus-visible{
  outline:none;
  box-shadow:0 0 0 3px color-mix(in oklab, var(--accent-500) 35%, transparent);
  border-radius:8px;
}

/* =======================
   HEADER (sticky poussé)
======================= */
.header{
  position: sticky;
  top: var(--stickTop);
  z-index: 600;
  isolation: isolate;
  transition: top .22s var(--easing);
  backdrop-filter:saturate(1.2) blur(10px);
  background: color-mix(in oklab, var(--panel) 94%, var(--bg) 6%);
  border-bottom:1px solid var(--ring);
  box-shadow: 0 6px 18px rgba(0,0,0,.08);
}
#hero-banner, #projects, #cases, #about, #contact, #legal { scroll-margin-top: calc(var(--headerH) + 10px); }

[data-theme=dark] .header{
  background: color-mix(in oklab, var(--panel) 88%, #000 12%);
  box-shadow: 0 8px 22px rgba(0,0,0,.45);
}
.h-row{display:flex;align-items:center;justify-content:space-between;padding:12px 16px}
.brand{display:flex;gap:12px;align-items:center}
.brand-links{display:flex;gap:6px;margin-top:2px}
.brand-icon{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:6px;border:1px solid var(--ring);color:var(--ink-700);text-decoration:none;transition:background .2s}
.brand-icon:hover{background:color-mix(in oklab,var(--panel)90%,var(--bg))}
#avatarImg{width:85px;height:85px;border-radius:999px;display:block;object-fit:cover;border:1px solid var(--ring);box-shadow:0 1px 2px rgba(0,0,0,.06)}
[data-theme=dark] #avatarImg{box-shadow:0 1px 2px rgba(0,0,0,.25)}

.btn{border:1px solid var(--ring);padding:6px 10px;border-radius:8px;background:transparent;cursor:pointer;transition:background .2s ease}
.btn:hover{background:color-mix(in oklab,var(--panel)90%,var(--bg))}

/* Nom dans le header (prénom plus gros) */
.brand-name{ display:block; line-height:1.1; font-size:clamp(16px, 1.6vw, 20px); }
.brand-name .first{ font-size:1.65em; font-weight:800; }
.brand-name .last { font-weight:700; opacity:.95; }

/* NAV (desktop) */
.primary-nav{ display:flex; align-items:center; gap:8px; }
.primary-nav a{
  display:inline-flex; align-items:center; justify-content:center;
  text-decoration:none; font-weight:700;
  font-size: clamp(15px, 1.2vw, 18px);
  padding: 10px 14px;
  border-radius: 8px;
  border: 1px solid transparent;
}
.primary-nav a:hover{
  background: color-mix(in oklab, var(--panel) 92%, var(--bg));
  border-color: var(--ring);
}
.primary-nav a.cta{
  border:1px solid color-mix(in oklab, var(--accent-500) 45%, var(--ring));
  background: color-mix(in oklab, var(--panel) 96%, var(--accent-500) 12%);
  box-shadow: 0 4px 14px rgba(0,0,0,.10);
}
.primary-nav a.cta:hover{
  background: color-mix(in oklab, var(--panel) 92%, var(--accent-500) 22%);
}

/* Burger : caché en desktop */
.nav-toggle{ display:none; }

/* ========= MOBILE ========= */
@media (max-width: 860px){
  .nav-toggle{ display:inline-flex; align-items:center; }
  .primary-nav{
    display:none;
    position: fixed;
    top: var(--headerH);
    left: 0; right: 0;
    z-index: 650;
    padding: 10px;
    background: color-mix(in oklab, var(--panel) 96%, var(--bg) 4%);
    border-bottom: 1px solid var(--ring);
    box-shadow: 0 14px 30px rgba(0,0,0,.18);
    flex-direction: column;
    gap: 8px;
  }
  .nav-chk:checked ~ .primary-nav,
  .header.menu-open .primary-nav{ display:flex; }
  .primary-nav a { width: 100%; }
}

/* =======================
   SLAB CENTRAL
======================= */
.page-slab{
  background:
    radial-gradient(1200px 600px at 10% 0%, rgba(0,0,0,.035), transparent 60%),
    radial-gradient(1000px 500px at 95% 10%, rgba(0,0,0,.03), transparent 55%),
    var(--slab);
  border-top: 1px solid color-mix(in oklab, var(--ring) 85%, transparent);
  border-bottom: 1px solid color-mix(in oklab, var(--ring) 85%, transparent);
  box-shadow:
    0 -1px 0 color-mix(in oklab, var(--ring) 70%, transparent) inset,
    0 1px 0 color-mix(in oklab, var(--ring) 70%, transparent) inset,
    0 18px 40px rgba(0,0,0,.06);
}
[data-theme=dark] .page-slab{
  background:
    radial-gradient(1200px 600px at 10% 0%, rgba(255,255,255,.04), transparent 60%),
    radial-gradient(1000px 500px at 95% 10%, rgba(255,255,255,.035), transparent 55%),
    var(--slab);
  box-shadow:
    0 -1px 0 color-mix(in oklab, var(--ring) 60%, transparent) inset,
    0 1px 0 color-mix(in oklab, var(--ring) 60%, transparent) inset,
    0 24px 60px rgba(0,0,0,.55);
}

/* CONTENT */
.hero{padding:54px 0 64px}
.hero-grid{
  display:grid;
  grid-template-columns:minmax(0, 1fr) minmax(350px, .9fr);
  gap:clamp(34px, 5vw, 74px);
  align-items:center;
}
.hero-grid > *{min-width:0}
.hero-copy{
  display:flex;
  flex-direction:column;
  align-items:flex-start;
  justify-content:center;
  max-width:800px;
}
.hero-kicker{
  display:inline-flex;
  align-items:center;
  gap:10px;
  color:var(--read-muted);
  font-size:13px;
  font-weight:800;
  letter-spacing:.08em;
  text-transform:uppercase;
}
.hero-kicker::before{
  content:"";
  width:44px;
  height:1px;
  background:color-mix(in oklab, var(--read-border) 70%, transparent);
}
.hero h1{
  margin:14px 0 0;
  max-width:12ch;
  color:var(--read-text);
  font-weight:850;
  line-height:1;
  font-size:clamp(3rem, 5.6vw, 5.8rem);
}
.hero-roles{
  margin:16px 0 0;
  color:var(--read-text);
  font-size:clamp(20px, 2vw, 28px);
  line-height:1.2;
  font-weight:750;
  overflow-wrap:break-word;
}
.hero-copy #heroDesc{
  max-width:64ch;
  margin:18px 0 0;
  font-size:clamp(15.5px, 1.25vw, 18px);
  line-height:1.58;
  overflow-wrap:break-word;
}
.hero-profile{
  display:grid;
  gap:0;
  align-self:center;
  min-width:0;
  min-height:0;
  padding-left:26px;
  border-left:1px solid color-mix(in oklab, var(--read-border) 82%, transparent);
}
.hero-profile > div{
  display:grid;
  gap:10px;
  align-content:center;
  min-height:0;
  padding:22px 0;
  border-top:1px solid color-mix(in oklab, var(--read-border) 58%, transparent);
}
.hero-profile > div:first-child{border-top:0}
.hero-profile span{
  color:var(--read-muted);
  font-size:12px;
  font-weight:800;
  letter-spacing:.08em;
  text-transform:uppercase;
}
.hero-profile strong{
  color:var(--read-text);
  max-width:46ch;
  font-size:clamp(16px, 1.28vw, 19px);
  line-height:1.38;
  font-weight:720;
  overflow-wrap:break-word;
}
.pill{display:inline-flex;align-items:center;border:1px solid var(--ring);padding:6px 10px;border-radius:8px;margin-right:8px;text-decoration:none}
.hero-cta{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}
.hero-cta .btn-cta{
  padding:0 0 3px;
  border:0;
  border-bottom:1px solid currentColor;
  border-radius:0;
  background:transparent;
  color:var(--read-text);
  font-weight:800;
}
.hero-cta .btn-cta:hover{
  background:transparent;
  color:var(--read-muted);
}
.career-strip{
  margin-top:52px;
  padding-top:28px;
  padding-bottom:30px;
  border-bottom:1px solid color-mix(in oklab, var(--read-border) 62%, transparent);
}
.career-strip-head{
  display:grid;
  gap:6px;
  margin-bottom:22px;
}
.career-strip-head span{
  color:var(--read-muted);
  font-size:12px;
  font-weight:800;
  letter-spacing:.08em;
  text-transform:uppercase;
}
.career-strip-head strong{
  color:var(--read-text);
  font-size:clamp(20px, 2vw, 28px);
  line-height:1.15;
}
.career-timeline{
  display:grid;
  grid-template-columns:repeat(6, minmax(0, 1fr));
  gap:0;
  list-style:none;
  margin:0;
  padding:0;
}
.career-timeline li{
  position:relative;
  min-width:0;
  padding:28px 18px 0 0;
}
.career-timeline li::before{
  content:"";
  position:absolute;
  top:10px;
  left:0;
  right:0;
  height:1px;
  background:color-mix(in oklab, var(--read-border) 68%, transparent);
}
.career-timeline li::after{
  content:"";
  position:absolute;
  top:5px;
  left:0;
  width:10px;
  height:10px;
  border-radius:999px;
  background:var(--read-text);
  box-shadow:0 0 0 4px color-mix(in oklab, var(--slab) 88%, transparent);
}
.career-timeline time{
  display:block;
  color:var(--read-muted);
  font-size:12px;
  font-weight:850;
  margin-bottom:8px;
}
.career-timeline strong{
  display:block;
  color:var(--read-text);
  font-size:14px;
  line-height:1.18;
  margin-bottom:7px;
}
.career-timeline span{
  display:block;
  color:var(--read-soft);
  font-size:12.5px;
  line-height:1.38;
  overflow-wrap:break-word;
}
.section{
  padding:72px 0;
}
.section h2{
  margin:0 0 26px;
  padding-bottom:14px;
  border-bottom:1px solid color-mix(in oklab, var(--read-border) 68%, transparent);
  color:var(--read-text);
  font-size:clamp(34px, 4vw, 52px);
  line-height:1;
  font-weight:850;
}
@media(max-width:860px){
  .hero.container{padding-left:24px;padding-right:24px}
  .hero{padding-top:42px;padding-bottom:44px}
  .hero-grid{grid-template-columns:1fr;gap:28px}
  .hero-copy,
  .hero-profile,
  .career-strip{
    width:100%;
    max-width:100%;
    min-width:0;
  }
  .hero h1{max-width:100%;font-size:clamp(2.55rem, 13vw, 4rem);line-height:1}
  .hero-roles{font-size:clamp(18px, 5.6vw, 24px)}
  .hero-roles,
  .hero-copy #heroDesc,
  .hero-profile strong,
  .career-timeline span{
    overflow-wrap:anywhere;
    word-break:normal;
  }
  .hero-profile{min-height:0;padding-left:18px}
  .career-strip{margin-top:36px;padding-top:24px;padding-bottom:26px}
  .career-strip-head{display:grid;gap:6px;margin-bottom:18px}
  .career-timeline{
    display:grid;
    grid-template-columns:1fr;
    border-left:1px solid color-mix(in oklab, var(--read-border) 68%, transparent);
    padding-left:18px;
  }
  .career-timeline li{padding:0 0 20px 0}
  .career-timeline li:last-child{padding-bottom:0}
  .career-timeline li::before{display:none}
  .career-timeline li::after{top:5px;left:-24px}
  .section{padding:52px 0}
  .section h2{font-size:clamp(32px, 9.5vw, 42px);margin-bottom:20px}
}
@media(max-width:560px){
  .h-row{padding:10px 12px;gap:8px}
  .brand{gap:8px;min-width:0}
  #avatarImg{width:62px;height:62px}
  .brand-name{font-size:14px;max-width:96px}
  .brand-name .first{font-size:1.45em}
  .brand-name .last{display:block;font-size:.95em}
  .brand-links{gap:4px}
  .brand-icon{width:24px;height:24px}
  .h-row > div:last-child{gap:6px !important;flex:0 0 auto}
  .btn{padding:6px 8px}
  #langBtn{font-size:12px;padding:6px 7px}
  .hero-copy,
  .hero-profile,
  .career-strip{
    max-width:342px;
  }
}

.main-contrast {
  background: var(--slab);
  max-width: 1600px;
  margin: 0 auto;
  padding: 0 0;
  box-shadow: 0 0 50px rgba(0,0,0,0.08) inset, 0 0 60px rgba(0,0,0,0.15);
}
[data-theme=light] .main-contrast { background: color-mix(in oklab, var(--cream-0) 80%, var(--cream-100) 20%); }
[data-theme=dark]  .main-contrast { background: color-mix(in oklab, var(--warm-800) 85%, #000 15%); }

/* GRID */
.masonry{ display:grid; gap:18px; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }
@media(min-width:700px){.masonry{grid-template-columns: repeat(auto-fill, minmax(320px, 1fr))}}
@media(min-width:1024px){.masonry{grid-template-columns: repeat(auto-fill, minmax(340px, 1fr))}}
@media(min-width:1400px){.masonry{grid-template-columns: repeat(4, minmax(0, 1fr))}}

.tile{
  position:relative;display:flex;flex-direction:column;
  background:var(--panel);border:1px solid var(--ring);
  padding:12px;cursor:pointer;
  border-radius:10px;
  box-shadow:0 1px 2px rgba(0,0,0,.03);
  transition:box-shadow .2s ease,transform .2s ease;
  min-height:320px;
  will-change: transform, box-shadow;
}
.tile:hover{box-shadow:0 10px 30px rgba(0,0,0,.08); transform:translateY(-1px)}
.tile:active{transform:translateY(1px)}

/* Generic media thumbs */
.thumb{position:relative;aspect-ratio:16/9;overflow:hidden;border-radius:10px}
.thumb img,.thumb iframe{width:100%;height:100%;object-fit:cover;display:block;border:0}

/* meta */
.meta-row{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-top:8px}
.tile h3{margin:0 0 6px}
.summary{
  font-size:14px;color:var(--ink-700);margin:10px 0 0;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
  min-height:40px;
}

/* Badge rôle */
.role-badge{
  display:inline-flex; align-items:center; gap:8px;
  font-size:12px; padding:4px 8px; border-radius:6px;
  border:1px solid var(--ring);
  background: color-mix(in oklab, var(--panel) 96%, var(--bg) 4%);
  color: var(--ink-700);
}
.role-badge .dot{
  width:7px; height:7px; border-radius:999px;
  background: color-mix(in oklab, var(--accent-500) 70%, var(--panel));
  box-shadow: 0 0 0 2px color-mix(in oklab, var(--accent-500) 25%, transparent);
}

/* Chips */
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:auto}
.chip,.chip-btn{font-size:12px;display:inline-flex;align-items:center;border:1px solid var(--ring);padding:2px 8px;border-radius:6px;background:transparent}
.chip-btn{cursor:pointer}

/* =======================
   CARDS & GRIDS
======================= */
.card{border-radius:10px;background:var(--panel);border:1px solid var(--ring);padding:16px}
.grid{display:grid;gap:16px}
@media(min-width:720px){.grid2{grid-template-columns:1fr 1fr}}
@media(min-width:900px){.grid3{grid-template-columns:repeat(3,1fr)}}

/* Footer */
.footer{background:var(--cream-100);padding:24px;text-align:center;border-top:1px solid var(--ring)}
[data-theme=dark] .footer{background:var(--warm-800)}

/* =======================
   MODAL & LIGHTBOX
======================= */
@keyframes modalIn{0%{opacity:0;transform:scale(.98) translateY(6px)}100%{opacity:1;transform:scale(1) translateY(0)}}
@keyframes modalOut{0%{opacity:1;transform:scale(1) translateY(0)}100%{opacity:0;transform:scale(.98) translateY(6px)}}

.modal-backdrop{
  position:fixed; inset:0; display:flex; align-items:center; justify-content:center;
  background:rgba(0,0,0,.45);
  backdrop-filter: blur(2px);
  z-index:2000; opacity:0; transition:opacity .22s var(--easing);
}
.modal-backdrop.backdrop-show{opacity:1}

.modal{
  max-width:860px; width:clamp(320px, 92vw, 860px);
  max-height:90vh; overflow:auto;
  position:relative;
  background:var(--panel); border:1px solid var(--ring); border-radius:10px; padding:16px;
  transform-origin:center;
  animation: modalIn .22s var(--easing) forwards;
  z-index:2010;
}
.modal--case-study{
  max-width:1180px;
  width:clamp(320px, 94vw, 1180px);
  padding:18px;
}
.modal--project{
  max-width:1040px;
  width:clamp(320px, 94vw, 1040px);
}
.modal.fade-out{ animation: modalOut .18s var(--easing) forwards; }

.modal header{display:flex;align-items:center;gap:8px;justify-content:space-between;margin-bottom:8px}
.modal header .back{margin-right:auto}
.x,.back{border:1px solid var(--ring);border-radius:8px;padding:4px 10px;background:transparent;cursor:pointer}

/* Media shell (vidéo/image dans modales) */
.media-shell{
  position:relative; width:100%; aspect-ratio:16/9; overflow:hidden;
  border-radius:10px; background:color-mix(in oklab, var(--panel) 90%, var(--bg));
}
.media-shell > *{ width:100%; height:100%; object-fit:cover; display:block }

/* Bande d’images */
.media-strip{ display:flex; gap:10px; overflow:auto; padding:8px 2px }
.media-strip img{ width:180px; height:110px; object-fit:cover; border-radius:8px; flex:0 0 auto; cursor:pointer; border:1px solid var(--ring) }
.modal--case-study .media-shell{
  aspect-ratio: 16/8.5;
  max-height: min(56vh, 620px);
  border-radius:10px;
}
.modal--case-study .media-strip img{
  width:210px;
  height:118px;
  border-radius:8px;
}
.modal--project .media-shell{
  aspect-ratio:21/9;
  max-height:min(50vh, 460px);
}
.modal--project .media-strip img{
  width:160px;
  height:90px;
}

/* CV modal toolbar & view */
.cv-toolbar{
  display:flex; gap:8px; position:sticky; top:0; z-index:5;
  background: color-mix(in oklab, var(--panel) 96%, var(--bg) 4%);
  border:1px solid var(--ring); border-radius:8px; padding:8px; margin-bottom:10px;
}
.cv-view{ overflow:hidden; border-radius:10px; border:1px solid var(--ring); background:var(--panel) }
.cv-view .cv-zoom{ will-change:transform }

/* Lightbox */
.lightbox{
  position:fixed; inset:0; display:grid; place-items:center;
  background:rgba(0,0,0,.85); z-index:2100;
  opacity:0; transition:opacity .18s var(--easing)
}
.lightbox.show{opacity:1}
.lightbox img{max-width:92vw;max-height:82vh;border-radius:10px}
